<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="021-create-savings-goal-contributions-table" author="fintogether">
        <createTable tableName="savings_goal_contributions">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="savings_goal_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_contribution_savings_goal" references="savings_goals(id)" deleteCascade="true"/>
            </column>
            <column name="amount" type="decimal(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="contributed_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="savings_goal_contributions" indexName="idx_contributions_savings_goal">
            <column name="savings_goal_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
