<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="016-add-parent-recurring-id-to-transactions" author="fintogether">
        <addColumn tableName="transactions">
            <column name="parent_recurring_id" type="uuid">
                <constraints foreignKeyName="fk_transaction_recurring_template" references="recurring_transaction_templates(id)"/>
            </column>
        </addColumn>

        <createIndex tableName="transactions" indexName="idx_transaction_parent_recurring_id">
            <column name="parent_recurring_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
