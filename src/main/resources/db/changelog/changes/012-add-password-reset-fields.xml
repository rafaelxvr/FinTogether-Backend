<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="012-add-password-reset-fields" author="fintogether">
        <addColumn tableName="users">
            <column name="reset_token" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="reset_token_expiry" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex tableName="users" indexName="idx_users_reset_token">
            <column name="reset_token"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
