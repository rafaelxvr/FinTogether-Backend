<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="022-create-transaction-splits-table" author="fintogether">
        <createTable tableName="transaction_splits">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transaction_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_split_transaction" references="transactions(id)" deleteCascade="true"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_split_user" references="users(id)"/>
            </column>
            <column name="amount" type="decimal(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="is_paid" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="paid_at" type="timestamp"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_splits_transaction" tableName="transaction_splits">
            <column name="transaction_id"/>
        </createIndex>

        <createIndex indexName="idx_splits_user" tableName="transaction_splits">
            <column name="user_id"/>
        </createIndex>

        <addUniqueConstraint
                constraintName="uk_split_transaction_user"
                tableName="transaction_splits"
                columnNames="transaction_id, user_id"/>
    </changeSet>

</databaseChangeLog>
