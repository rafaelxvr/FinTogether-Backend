<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="024-create-credit-card-payments-table" author="fintogether">
        <createTable tableName="credit_card_payments">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="credit_card_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_payment_credit_card" references="credit_cards(id)" deleteCascade="true"/>
            </column>
            <column name="reference_month" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="paid_amount" type="decimal(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="paid_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="payment_account_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_payment_account" references="accounts(id)"/>
            </column>
            <column name="notes" type="varchar(500)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="credit_card_payments"
                columnNames="credit_card_id, reference_month"
                constraintName="uq_payment_card_month"/>

        <createIndex tableName="credit_card_payments" indexName="idx_payments_card">
            <column name="credit_card_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
